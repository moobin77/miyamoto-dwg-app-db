rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 100 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Departments Collection
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isValidId(departmentId);
    }

    // Drawings Collection
    match /drawings/{drawingId} {
      allow read: if true;
      allow write: if isValidId(drawingId);
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidId(notificationId);
    }

    // Acknowledgments Collection (Sign-off logs)
    match /acknowledgments/{ackId} {
      allow read: if true;
      allow create: if isValidId(ackId);
      allow update, delete: if isValidId(ackId);
    }

    // System Status & Metadata
    match /system_status/{statusId} {
      allow read: if true;
      allow write: if isValidId(statusId);
    }
  }
}
